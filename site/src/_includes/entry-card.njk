{% macro card(e) %}
{% set b = e.verify_status | badge %}
<div class="entry-card">
  {% if e.yoruba %}<div class="yoruba">{{ e.yoruba }}</div>{% endif %}
  {% if e.english %}<div class="english">{{ e.english }}</div>{% endif %}
  {% if e.drop_english %}<p>{{ e.drop_english }}</p>{% endif %}
  <div class="meta">
    <span class="badge {{ b.cls }}">{{ b.label }}</span>
    <span>{{ e.domain }}{% if e.category %} · {{ e.category }}{% endif %}</span>
    {% if e.source_citation %}<span>· {{ e.source_citation }}</span>{% endif %}
  </div>
</div>
{% endmacro %}
