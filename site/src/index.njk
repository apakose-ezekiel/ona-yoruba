{% set sample = entries | where("domain", "njeomo") | limit(1) %}
<section class="game-cta">
  <div class="game-cta-inner">
    <div class="game-cta-text">
      <p class="hero-eyebrow">Nje O Mọ? — Did You Know</p>
      <h2>Ṣe o mọ Yorùbá dáadáa? — Test your knowledge</h2>
      <p>{{ entries | where("domain", "njeomo") | length }} quiz questions pulled straight from fieldwork records — same set playable here or on the Telegram bot. Got a question of your own, or something to correct? Send it our way.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/quiz/">Ṣeré Quiz — Play the Quiz</a>
        <a class="btn" href="https://t.me/OnaYorubaBot" target="_blank" rel="noopener">Beere Ìbéèrè — Ask on Telegram</a>
        <a class="btn" href="https://wa.me/8183879878" target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
    {% if sample.length %}
    <div class="sample-question">
      <p class="sample-label">Àpẹẹrẹ ìbéèrè — Sample question</p>
      <p class="sample-q">{{ sample[0].question_english or sample[0].english }}</p>
      <a class="btn small" href="/quiz/">Fi ìdáhùn hàn →</a>
    </div>
    {% endif %}
  </div>
</section>

